{
  "name": "com.bearlygames.dialogue-tree-editor",
  "version": "0.1.1",
  "displayName": "Dialogue-Tree Node Editor",
  "description": "This is a plugin designed to make Dialogue trees in Unity",
  "unity": "2021.3",
  "unityRelease": "0b5",
  "keywords": [
    "Dialogue",
    "Node",
    "Nodes"
  ],
  "author": {
    "name": "Bearly-Games"
  },
  "_upm": {
    "Added": [
      "- Branch node",
      "- EventTrigger node",
      "- Event that returns dialogue string",
      "- `public static Action<string> DisplayDialogue;`",
      "- `DialogueGraphNode.DisplayDialogue += UpdateText;`"
    ],
    "Changed": [
      "- DialogueTreeAssets start with a Start node",
      "- Start node can't be deleted.",
      "- Tagged unfinished nodes as `(Experimental)`"
    ]
  },
  "samples": [
    {
      "displayName": "Dialogue Samples",
      "description": "Contains basic setup for dialogue trees.",
      "path" : "Samples~/DialogueSamples"
    },
    {
      "displayName": "Dialogue Scene Samples",
      "description": "Contains scenes that show the full system in action.",
      "path" : "Samples~/SampleScenes"
    }
  ]
}
