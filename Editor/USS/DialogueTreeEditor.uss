DialogueTreeGraphView{
    flex-grow: 1;
}
.edge{
    color: chartreuse;
    background-color: chartreuse;
    --edge-color: teal;
    --selected-edge-color: yellow;
    --ghost-edge-color: red;
    --edge-width: 8px;
}

#Grid {
    --thick-lines: 0;
    --spacing:20;
    --grid-background-color: rgb(40, 40, 40);
    --line-color: rgb(35, 35, 35);
}
#DialogueNode #title {
    background-color: #3e5a7c;
}
#DialogueBranch #title {
    background-color: rgba(175,118,6,0.9);
}
#IfConditionNode #title {
    background-color: rgba(175,84,165,0.9);
}
#EventTriggerNode{
    width: 360px;
}
#EventTriggerNode #title{
    background-color: #434f27;
}
#node-border {
  background-color: #232323;
}
PropertyField {
    flex-grow: 1;
    overflow: visible;
}
TextField .unity-label {
    -unity-font-style: bold-and-italic;
}
TextField
{
    flex-grow: 0;
    flex-direction: column;
    margin: 2px 0;
}
#unity-text-input {
    color: black;
    background-color: whitesmoke;
    -unity-text-align: upper-left;
    white-space: normal;
    min-width: 128px;
    max-width: 256px;
    padding: 6px;
}
#unity-text-input .unity-text-element {
    font-size: 11px;
}
TextInput {
    overflow: visible;
}
TextElement {
    
    overflow: scroll;
}
#extension {
    flex-grow: 1;
    height: auto;
    flex-direction: row
}
.actorField{
    flex-direction: column;
    align-self: flex-start;
}
.actorField Label{
    -unity-font-style: bold-and-italic;
}
.actorIcon
{
    height: auto;
    min-height: 128px;
    min-width: 32px;
    flex-grow: 1; 
    -unity-background-scale-mode: scale-to-fit;
    border-width: 2px;
    border-color: whitesmoke;
}
ObjectFieldDisplay {
    flex-grow: 1;
    max-height: 16px;
}
ListView {
    min-width: 256px;
    min-height: 128px;
}

.choicesList {
    flex-grow: 1;
}

.choice-text-field {
    margin: 2px 0;
    min-height: 16px;
}

.branch-view {
    margin-top: 10px;
    padding-top: 10px;
}

ListView {
    min-height: 100px;
    max-height: 300px;
    margin: 4px;
    border-width: 4px;
}
.unity-scroll-view {
    min-height: 128px;
    flex-grow: 1;
    flex-direction: column;
}